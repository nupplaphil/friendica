parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc type Friendica\\Module\\Api\\ApiResponse of property Friendica\\Module\\BaseApi\:\:\$response is not the same as PHPDoc type Friendica\\Capabilities\\ICanCreateResponses of overridden property Friendica\\BaseModule\:\:\$response\.$#'
			identifier: property.phpDocType
			count: 1
			path: src/Module/BaseApi.php

		-
			message: '#^Method Friendica\\Core\\Config\\Capability\\IManageConfigValues\:\:get\(\) invoked with 4 parameters, 1\-3 required\.$#'
			identifier: arguments.count
			count: 3
			path: tests/src/Core/Config/ConfigTest.php

		-
			message: '#^Variable \$dice in PHPDoc tag @var does not exist\.$#'
			identifier: varTag.variableNotFound
			count: 1
			path: tests/src/Core/InstallerTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertEmpty\(\) with ''test'' will always evaluate to false\.$#'
			identifier: staticMethod.impossibleType
			count: 1
			path: tests/src/Model/User/CookieTest.php

		-
			message: '#^Access to an undefined property Friendica\\Profile\\ProfileField\\Entity\\ProfileField\:\:\$wrong\.$#'
			identifier: property.notFound
			count: 1
			path: tests/src/Profile/ProfileField/Entity/ProfileFieldTest.php

		-
			message: '#^Expression "\$entity\-\>wrong" on a separate line does not do anything\.$#'
			identifier: expr.resultUnused
			count: 1
			path: tests/src/Profile/ProfileField/Entity/ProfileFieldTest.php

		-
			message: '#^Binary operation "\-" between string and string results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: tests/src/Util/DateTimeFormatTest.php

		-
			message: '#^PHPDoc tag @var with type Friendica\\Object\\EMail\\IEmail is not subtype of native type null\.$#'
			identifier: varTag.nativeType
			count: 2
			path: tests/src/Util/EMailerTest.php

