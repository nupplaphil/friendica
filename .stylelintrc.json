{
	"extends": "stylelint-config-recommended",
	"ignoreFiles": [
		"addon/**",
		"node_modules/**",
		"vendor/**",
		"view/asset/**",
		"view/theme/frio/frameworks/**",
		"**/*.min.css",
		"**/*.min.*.css",
		"view/fonts/**",
		"view/js/fancybox/**",
		"view/js/friendica-tagsinput/**",
		"view/js/videojs/**",
		"view/theme/frio/css/font-awesome.custom.css",
		"view/theme/frio/font/**",
		"view/theme/vier/css/remixicon-vier.css"
	],
	"rules": {
		"no-descending-specificity": null,

		"declaration-block-no-duplicate-properties": [true, {
			"ignore": ["consecutive-duplicates-with-different-values"]
		}]
	},
	"overrides": [
		{
			"files": [
				"view/theme/frio/css/*.css",
				"view/theme/frio/scheme/*.css"
			],
			"rules": {
				"declaration-property-value-no-unknown": [true, {
					"ignoreProperties": { "/.*/": ["/\\$[a-z_]+/"] }
				}]
			}
		}
	]
}
